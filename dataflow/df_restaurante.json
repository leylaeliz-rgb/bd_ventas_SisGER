{
	"name": "df_restaurante",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurante_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 split(!isNull(restaurante_id) &&!isNull(nombre_restaurante) &&!isNull(tipo_cocina) && !isNull(calificacion_promedio) &&!isNull(activo),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos derive(activo = iif(in(['si', 'sí', 'activo'], lower(trim(activo))), 'Sí', 'No'),",
				"          calificacion_promedio = toDecimal(calificacion_promedio)) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as decimal(3,2),",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre_restaurante,",
				"          tipo_cocina,",
				"          calificacion_promedio,",
				"          activo",
				"     )) ~> sink1"
			]
		}
	}
}