{
	"name": "df_inventario_df",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "inventario_diario_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "inventario_diario_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          inventario_id as string,",
				"          fecha_inventario as string,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as string,",
				"          entradas as string,",
				"          salidas as string,",
				"          stock_final as string,",
				"          punto_reorden as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(inventario_id = upper(trim(inventario_id)),",
				"          producto_id = upper(trim(producto_id)),",
				"          sucursal_id = upper(trim(sucursal_id)),",
				"          fecha_inventario = toDate(trim(fecha_inventario), 'yyyy-MM-dd'),",
				"          stock_inicial = toInteger(trim(stock_inicial)),",
				"          entradas = toInteger(trim(entradas)),",
				"          salidas = toInteger(trim(salidas)),",
				"          punto_reorden = toInteger(trim(punto_reorden)),",
				"          stock_final = toInteger(trim(stock_inicial)) + toInteger(trim(entradas)) - toInteger(trim(salidas))) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(inventario_id) &&  !isNull(sucursal_id) &&  !isNull(producto_id) &&  !isNull(fecha_inventario) &&  stock_inicial >= 0 &&  entradas >= 0 &&  salidas >= 0 &&  punto_reorden >= 0 && stock_final == (stock_inicial + entradas - salidas) && stock_final >= 0,",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          inventario_id as string,",
				"          fecha_inventario as date,",
				"          sucursal_id as string,",
				"          producto_id as string,",
				"          stock_inicial as integer,",
				"          entradas as integer,",
				"          salidas as integer,",
				"          stock_final as integer,",
				"          punto_reorden as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          inventario_id,",
				"          fecha_inventario,",
				"          sucursal_id,",
				"          producto_id,",
				"          stock_inicial,",
				"          entradas,",
				"          salidas,",
				"          stock_final,",
				"          punto_reorden",
				"     )) ~> sink1"
			]
		}
	}
}