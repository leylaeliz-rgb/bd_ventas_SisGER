{
	"name": "df_pagos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pagos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pagos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as string,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(pago_id = upper(trim(pago_id)),",
				"          pedido_id = upper(trim(pedido_id)),",
				"          fecha_pago = toDate(trim(fecha_pago), 'yyyy-MM-dd'),",
				"          metodo_pago = initCap(trim(metodo_pago)),",
				"          estado_pago = iif(in(['aprobado', 'completado', 'exitoso'], lower(trim(estado_pago))), 'Aprobado', initCap(trim(estado_pago))),",
				"          monto_pagado = toDecimal(replace(trim(regexReplace(toString(monto_pagado), '[^0-9.,-]', '')), ',', '.'), 10, 2)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(pago_id) &&  !isNull(pedido_id) &&  !isNull(fecha_pago) &&  monto_pagado > 0.00 &&  in(['Efectivo', 'Tarjeta', 'Transferencia', 'QR', 'Billetera Móvil'], metodo_pago) &&  in(['Aprobado', 'Pendiente', 'Rechazado'], estado_pago),",
				"     disjoint: false) ~> split1@(valido, rechazado)",
				"split1@valido sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as timestamp,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as decimal(12,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}